{
  "Kestrel": {
    "Endpoints": {
      "HttpsInlineCertAndKeyFile": {
        "Url": "https://localhost:8001",
        "Certificate": {
          "Path": "./bin/Debug/fullchain.pem",
          "KeyPath": "./bin/Debug/privkey.pem"
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "[yyyy.MM.dd HH:mm:ss] "
      }
    }
  }
}
