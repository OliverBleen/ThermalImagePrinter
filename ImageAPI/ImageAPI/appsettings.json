{
  "Kestrel": {
    "Endpoints": {
      "HttpsInlineCertAndKeyFile": {
        "Url": "https://localhost:8001",
        "Certificate": {
          "Path": "/certs/fullchain.pem",
          "KeyPath": "/certs/privkey.pem"
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "[yyyy.MM.dd HH:mm:ss] "
      }
    }
  },
  "AllowedHosts": "*"
}
